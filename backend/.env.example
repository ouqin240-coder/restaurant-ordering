# 服务配置
NODE_ENV=development
PORT=3000

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_NAME=restaurant_db
DB_USER=restaurant
DB_PASSWORD=restaurant123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=24h
MERCHANT_JWT_EXPIRES_IN=8h

# 微信小程序 / 公众号
WX_APP_ID=your_wx_app_id
WX_APP_SECRET=your_wx_app_secret

# 微信支付 v3
WX_PAY_MCH_ID=your_mch_id
WX_PAY_API_V3_KEY=your_api_v3_key
WX_PAY_SERIAL_NO=your_serial_no
WX_PAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WX_PAY_NOTIFY_URL=https://yourdomain.com/api/v1/payments/wx-notify

# 阿里云 OSS（菜品图片）
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your-bucket-name
OSS_BASE_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com

# 前端域名（CORS白名单）
CUSTOMER_H5_URL=http://localhost:5173
MERCHANT_ADMIN_URL=http://localhost:5174
